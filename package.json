{
  "name": "horror-web-comic",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "serve": "python3 -m http.server 8080",
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test tests/e2e",
    "test:perf": "playwright test tests/perf",
    "test:perf:webkit": "playwright test tests/perf/fps.spec.js --project=mobile-webkit --project=desktop-webkit",
    "lhci": "lhci autorun",
    "validate": "node scripts/validate-manifest.mjs",
    "report": "node scripts/compatibility-report.mjs",
    "build:images": "node scripts/build-images.mjs",
    "build": "npm run validate && node scripts/build.mjs",
    "ci": "npm run preflight && npm run validate && npm run test:unit && npm run build:images && npm run build && npm run test:e2e && npm run test:perf",
    "ci:lighthouse": "npm run lhci"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.24.2",
    "sharp": "0.33.5"
  }
}
