{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horror-web-comic.local/contracts/story-manifest.schema.json",
  "title": "Story Manifest",
  "description": "Contrato de conte\u00fado do player cinematogr\u00e1fico de quadros.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "defaultFrameDurationMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 30000
    },
    "defaultTransition": {
      "$ref": "#/$defs/transition"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "sensoryAdvisory": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "frames"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "defaultFrameDurationMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000,
          "default": 1500
        },
        "defaultTransition": {
          "$ref": "#/$defs/transition"
        },
        "audio": {
          "$ref": "#/$defs/audioTrack"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "image",
        "description",
        "alt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "audio": {
          "$ref": "#/$defs/audioTrack"
        },
        "image": {
          "$ref": "#/$defs/imageAsset"
        },
        "fx": {
          "$ref": "#/$defs/frameEffect"
        },
        "memoryIllusion": {
          "$ref": "#/$defs/memoryIllusion"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "fade",
            "zoom-in",
            "zoom-out",
            "dissolve",
            "slide-left",
            "slide-right",
            "none"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 600
        },
        "easing": {
          "type": "string",
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ],
          "default": "ease-in-out"
        }
      }
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avif",
        "fallback",
        "width",
        "height"
      ],
      "properties": {
        "avif": {
          "type": "string",
          "minLength": 1
        },
        "webp": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "avifSrcset": {
          "$ref": "#/$defs/widthSrcset"
        },
        "webpSrcset": {
          "$ref": "#/$defs/widthSrcset"
        },
        "fallbackSrcset": {
          "$ref": "#/$defs/widthSrcset"
        },
        "srcset": {
          "type": "string",
          "minLength": 1
        },
        "sizes": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "widthSrcset": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\s*\\S+\\s+[1-9]\\d*w(?:\\s*,\\s*\\S+\\s+[1-9]\\d*w)*\\s*$"
    },
    "audioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        }
      }
    },
    "frameEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "glitch",
            "optical-distortion",
            "flash-reveal"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 500,
          "default": 250
        },
        "intensity": {
          "type": "string",
          "enum": [
            "subtle",
            "moderate"
          ]
        },
        "audioCue": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memoryIllusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 125
        },
        "audioCue": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 500,
          "default": 250
        },
        "cssClass": {
          "type": "string",
          "enum": [
            "memory-distortion",
            "memory-distortion-severe"
          ],
          "default": "memory-distortion"
        }
      }
    }
  }
}